{
  "rateLimit": {
    "userCooldownMs": 2000,
    "userPerMinute": 8,
    "userPerHour": 60,
    "userPerDay": 200,
    "groupPerMinute": 20,
    "groupPerHour": 200,
    "globalMaxConcurrent": 3,
    "globalPerMinute": 30,
    "queueMax": 15,
    "queueTimeoutMs": 20000,
    "violationsToCooldown": 5,
    "penaltyCooldownMs": 30000,
    "floodWindowMs": 10000,
    "floodCount": 15,
    "penaltyMuteMs": 300000
  },
  "cooldown": {
    "pokeMs": 3000,
    "shakeMs": 2000,
    "forwardDelayMs": 800,
    "forwardMs": 5000
  },
  "engage": {
    "ttlMs": 600000,
    "initiatorLeft": 3,
    "otherLeft": 1
  },
  "chat": {
    "botReply": true,
    "keyword": "小钠",
    "voice": true,
    "extraPrompt": ""
  },
  "notice": {
    "enabled": true,
    "joinText": "欢迎新人加入群聊！",
    "leaveText": "{name} {kind}{note}"
  },
  "asr": {
    "canonicalName": "小钠",
    "homophones": "小娜,小纳,小呐,小哪,小那,晓娜,晓纳,晓钠,筱钠,筱娜,小拿,笑纳"
  },
  "bind": {
    "maxPerQQ": 5,
    "unbindRetainDays": 15
  },
  // 联网搜索后端（网页「全局设置」可切换）
  //   provider = off关闭 | baidu百度智能搜索 | deepseekDeepSeek官方搜索 | custom自定义接口
  // 密钥在 .env：BAIDU_SEARCH_KEY / SEARCH_CUSTOM_KEY（deepseek 复用 AI_API_KEY）
  "search": {
    "provider": "baidu",
    "customUrl": "",
    "limit": 5
  },
  // 图像识别后端：ai 用 AI 主模型 | custom 自定义视觉接口 | off 关闭
  // 自定义接口密钥在 .env 的 VISION_CUSTOM_KEY
  "vision": {
    "provider": "ai",
    "customUrl": "",
    "customModel": ""
  },
  // MC 服务器连接模式：""用 .env 的 MC_BRIDGE_URL | off无连接 | loopback本地回环 | lan局域网 | public公网地址
  // 密钥/桥接群仍看 .env 的 MC_BRIDGE_SECRET / MC_BRIDGE_GROUP
  "bridge": {
    "mode": "",
    "port": 25565,
    "lanHost": "",
    "publicUrl": ""
  }
}