{
  // ============================================================
  // 小钠 · 运行时可调参数（冷却 / 限流 / 时效）
  //
  // 和 .env 的分工：
  //   .env         —— 密钥、账号、开关这类"部署相关"的东西（token / 密码 / 群号…）
  //   config.json  —— 可以随心情改的数值（冷却、限流、超时…），本文件即为此用途
  //
  // 改完重启生效。支持 // 行注释和 /* */ 块注释，缺字段自动用内置默认值兜底，
  // 所以删掉几行也不会崩；数值必须是 ≥ 0 的数字，非法值会被忽略并回退默认。
  // ============================================================

  // ---- 限速（rateLimit.js）：正常聊天几乎无感，只对刷屏动手 ----
  "rateLimit": {
    "userCooldownMs": 2000,      // 同一用户两条消息的最小间隔（不足则静默排队）
    "userPerMinute": 8,          // 用户每分钟上限（超出则排队）
    "userPerHour": 60,           // 用户每小时上限（超出则提示"歇一会儿"）
    "userPerDay": 200,           // 用户每日上限（超出则提示"明天再来"）
    "groupPerMinute": 20,        // 群每分钟上限（私聊不参与）
    "groupPerHour": 200,         // 群每小时上限
    "globalMaxConcurrent": 3,    // 同时在跑的 AI 请求数（信号量）
    "globalPerMinute": 30,       // 全局每分钟上限
    "queueMax": 15,              // 等待队列上限，满了才拒绝
    "queueTimeoutMs": 20000,     // 排队超过这么久就放弃并提示
    "violationsToCooldown": 5,   // 连续超限多少次 → 冷却
    "penaltyCooldownMs": 30000,  // 冷却时长（期间静默）
    "floodWindowMs": 10000,      // 恶意刷屏判定窗口
    "floodCount": 15,            // 窗口内请求数达到该值 → 禁言
    "penaltyMuteMs": 300000      // 禁言时长（期间静默）
  },

  // ---- 各类冷却 ----
  "cooldown": {
    "pokeMs": 3000,              // 戳一戳：同一会话的回应冷却，连点不刷屏
    "shakeMs": 2000,             // 摇一摇：同一会话的接话间隔
    "forwardDelayMs": 800,       // 聊天记录转发：每人两条之间的间隔（下限 500）
    "forwardMs": 5000            // 聊天记录转发：同一个群两次发送的最小间隔
  },

  // ---- 「唤起会话」：被叫到之后，接下来几条没 @ 也继续判断 ----
  "engage": {
    "ttlMs": 600000,             // 会话有效期（每次互动都续期），默认 10 分钟
    "initiatorLeft": 3,          // 首先唤起的人：最多再检查几条
    "otherLeft": 1               // 其他人插嘴：只检查几条
  },

  // ---- GriefLogger 服务器记录查询（方块破坏/放置、容器存取、击杀等）----
  "grief": {
    "threshold": 50,             // 条数超过它：AI 路径先问"是否继续"；#查记录用它当展示上限
    "defaultHours": 24,          // 未指定时间范围时，默认往回查多少小时
    "maxRows": 100               // 单次最多取回多少条（同时也是喂给 AI 总结的条数上限）
  }
}