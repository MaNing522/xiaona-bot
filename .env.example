# 复制为 .env 后填写自己的值（.env 已被 .gitignore 排除，不会上传）
# 说明：**没填的项对应的功能会自动停用**，机器人不会因此报错崩溃；
#       启动时会打印一份「功能状态」清单，告诉你哪些开着、哪些因为缺配置关着。
#       需要某个功能时，把对应配置补上、重启即可自动启用。

# ===== SnowLuma(OneBot11) 连接：真实QQ账号 =====
# SnowLuma 通过注入桌面 QQ.exe 工作，只能扫码登录；启动器会自动拉起 QQ 与 SnowLuma。
# 这里的 token 会被启动器写进 snowluma/config/onebot.json 的 ws accessToken，两边保持一致；
# 留空则自动生成并保存在 SnowLuma 配置里（重启不变）。
ONEBOT_WS=ws://127.0.0.1:3001
ONEBOT_TOKEN=
# QQ 安装路径（留空用默认 C:\Program Files\Tencent\QQNT\QQ.exe）
QQ_PATH=
# 启动器发现 QQ 未运行时是否自动拉起（false = 自己手动打开 QQ）
QQ_AUTOLAUNCH=true
# 自动拉起 QQ 后是否静默启动（最小化到任务栏；扫码时从任务栏点回来即可）
QQ_START_MINIMIZED=true

# 所有者QQ（最高权限：可增删主人，只能通过改这里的 .env 更换）；管理员QQ（逗号分隔）
BOT_OWNER=
# 主人2（.env 写死的主人档，权限同主人；留空 = 不启用）
BOT_OWNER_BACKUP=
BOT_ADMINS=
# 所有者主页/推广链接：会显示在 #状态 里（所有人可见，留空则不显示）
BOT_OWNER_HOME=

# 忽略的机器人QQ（逗号分隔），其消息不响应；默认已内置 Q群管家(2854196310)
BOT_IGNORE_QQ=

# ===== AI 配置 =====
# 服务商：deepseek(默认) / openai / custom（任何 OpenAI 兼容接口都可以选 custom 再填 URL+MODEL）
AI_PROVIDER=deepseek
# 下面两项留空则用所选服务商的默认值；显式填写优先
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-flash

# ===== 联网搜索 =====
# 用哪个后端、返回几条、自定义接口地址，都已移到 config.json 的 search 段（网页「全局设置」可切换）：
#   provider = off 关闭 / baidu 百度智能搜索 / deepseek DeepSeek 官方搜索 / custom 自定义接口
# 这里只放密钥：
# 百度智能搜索：密钥形如 bce-v3/ALTAK-xxx/xxx
BAIDU_SEARCH_KEY=
# 自定义搜索接口的密钥（留空则接口免鉴权访问）。DeepSeek 搜索复用上面的 AI_API_KEY，不用另填。
SEARCH_CUSTOM_KEY=

# ===== 图像识别（多模态）=====
# 用哪个后端在 config.json 的 vision 段（ai 用 AI 主模型 / custom 自定义视觉接口 / off 关闭）
# 自定义视觉接口（OpenAI 兼容 /chat/completions，需支持 image_url 图片输入）的密钥；留空则免鉴权
VISION_CUSTOM_KEY=

# ===== 语音合成 =====
# 后端：xiaomi（小米 MiMo，支持情绪标签与唱歌）/ edge（微软 Edge，免密钥）
# 不填 TTS_PROVIDER 时：配了 MIMO_API_KEY 就用小米，否则用 Edge
TTS_PROVIDER=xiaomi
# 小米 MiMo API Key（https://platform.xiaomimimo.com 获取）
MIMO_API_KEY=
# 小米音色：冰糖（中文女声，默认）/ 茉莉（中文女声）/ 苏打 / 白桦（中文男声）
TTS_XIAOMI_VOICE=冰糖
# 可选：给小米 TTS 的一句自然语言风格指令（不会被读出来）
TTS_XIAOMI_INSTRUCT=
# --- 以下仅 TTS_PROVIDER=edge 时生效 ---
# 音色短名：zh-CN-XiaoxiaoNeural 是女声 XiaoXiao；完整列表可跑 edge-tts --list-voices 查
# 语速：带正负号与 %（如 +8% / -10% / +0%）
# 音量：相对默认音量的增减，Edge 常用范围 -100% ~ +100%（+100% 已是最大音量）
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# ===== #余额 累计统计 =====
# DeepSeek 只给"当前余额"，没有历史账单接口；"累计充值/已使用"默认自首次查询起本地记账。
# 想覆盖更早的历史，用主人命令直接设定：#余额矫正 <充值总金额> <已使用> [币种]（单位：元）
# 设定后每笔充值都会在该基数上继续累加。

# ===== 存储（默认相对项目目录 data）=====
SAVE_DIR=

# ===== 日志（logger.js）=====
# 级别：trace / debug / info / warn / error / fatal（默认 info）
# 输出三处：终端（emoji 显示为 [表情]）、网页面板实时日志、logs/YYYY-MM-DD.log
LOG_LEVEL=info

# ===== 限速与冷却 =====
# 已全部移到 **config.json**（与 .env 分离）：限速、各类冷却、唤起会话都在那里调。
# 详见 config.json 内的注释，这里只留一句提醒，不再重复列键名。

# ===== 成本优化（aiService.js / idle.js）=====
# 输出 token 是成本大头，必须设上限（不设 = 放任模型写长）
AI_MAX_TOKENS=512             # 日常聊天
AI_MAX_TOKENS_SHORT=300       # 一句话的短问答
AI_MAX_TOKENS_LONG=1200       # 明确要长文（总结/展开/写一篇）
# 闲时维护（避开工作日 9:00-12:00、14:00-18:00）
IDLE_INTERVAL_MS=21600000     # 维护间隔（默认 6 小时）
IDLE_KICKOFF_MS=60000         # 启动后多久第一次尝试
VOICE_CACHE_KEEP=50           # 语音缓存保留文件数

# ===== 合并转发（#聊天记录）=====
# 转发间隔与同群冷却已移到 config.json 的 cooldown。

# ===== 网页控制面板 (webui.js) =====
# 账号 / 密码 / 监听地址（0.0.0.0 = 公开到局域网，127.0.0.1 = 仅本机）
# 面板能控制机器人（以机器人身份发消息、用 QQ 账密启动登录），务必自己设一个强密码；留空则面板不启动
WEBUI_HOST=127.0.0.1
# 面板协议：默认 HTTP（简单、无证书提示）；HTTPS 代码完整保留，设 true 即切回 HTTPS。
WEBUI_HTTPS=false
# 面板端口：HTTP 默认 80，HTTPS 默认 443（均需管理员，启动.bat 已自动提权）。
# 端口被占用（如 Steam++/IIS/nginx）时会自动顺延（HTTP: 8080→9080；HTTPS: 8443→9443），
# 并在启动日志里打印实际监听端口；想固定端口就改这里。
WEBUI_PORT=80
# 仅 HTTPS 模式：HTTP（老地址）自动跳转到 HTTPS 的端口；设 0 关闭（已有 nginx 等做跳转时）
WEBUI_HTTP_PORT=80
# ---- 以下仅在 WEBUI_HTTPS=true 时生效 ----
# 首次启动自动生成本地根 CA（data/tls/ca.crt）并由它签发服务器证书（data/tls/cert.pem），
# 之后复用；服务器证书剩 < 30 天自动重签。
# 自动把本地根 CA 装进「当前用户 → 受信任的根证书颁发机构」（Chrome / Edge / IE 立即生效，
# 浏览器不再报「不安全」）。不想改系统证书库（或由域策略统一管理）就设 false。
WEBUI_TLS_TRUST=true
# Firefox 用自己的证书库，不会读 Windows 的：设置 → 隐私与安全 → 证书 → 查看证书 →
# 证书颁发机构 → 导入 data/tls/ca.crt（勾选「信任由此颁发机构标识的网站」）。
# 局域网其它设备访问时需各自导入 data/tls/ca.crt。
# 生成证书需要 openssl（Git for Windows 自带）；找不到时可用 OPENSSL_BIN 指定完整路径。
# OPENSSL_BIN=C:\Program Files\Git\usr\bin\openssl.exe
WEBUI_USER=admin
WEBUI_PASSWORD=
# 面板放在反向代理（nginx 等）后面才开：开启后按 X-Forwarded-For 统计登录限速
WEBUI_TRUST_PROXY=false

# ===== 记忆配置 (memory.js) =====
# 记忆按「人」存（QQ 号 / 游戏玩家），只记录触发过 AI 回复的消息。
# 每人保留条数（5~20）与每次注入的上下文条数（5~50）在 config.json 的
# memory.maxUserMessages / ai.contextMessages 里调（网页「全局设置」也能改，热加载生效）
MEMORY_MAX_LONGTERM=50
MEMORY_MAX_AGE_DAYS=30

# ===== 唤起会话（被 @/叫名字之后，接着几条没 @ 也继续判断是否在跟它说话）=====
# 额度在代码里固定：首先唤起的人 3 条、其他人插嘴 1 条；有效期 10 分钟（互动即续期）
# 想排查唤起行为时置 true，会在终端打印每次判断的额度消耗
ENGAGE_DEBUG=false

# ===== 人工接管 (takeover) =====
TAKEOVER_TIMEOUT=0

# ===== Minecraft 服务器桥（mcbridge.js ↔ 服务端 mod）=====
# 服务器侧 mod 在与 Minecraft 相同的端口上提供接口。
# 连不连、连哪台，可在 config.json 的 bridge 段（网页「全局设置」可切换）：
#   mode = ''（用下面的 MC_BRIDGE_URL）/ off 无连接 / loopback 本地回环 / lan 局域网 / public 公网地址
# 例：服务器 IP 为 1.2.3.4、config.json 里 http.sharePort=43733 → http://1.2.3.4:43733
MC_BRIDGE_URL=
# 喂给 AI 的服务器名字（可选，让 AI 知道自己在哪个服；留空则只用地址）。地址自动取自 MC_BRIDGE_URL。
MC_SERVER_NAME=
# 必须与服务器 config/xiaona/config.json 里的 bridge.secret 完全一致，且不少于 32 个字符
MC_BRIDGE_SECRET=
# 桥接群号：游戏聊天发到这个群，这个群的消息也会转发进游戏（留空则游戏消息不发 QQ）
MC_BRIDGE_GROUP=
# 各部分开关
MC_BRIDGE_MC_TO_QQ=true
MC_BRIDGE_QQ_TO_MC=true
MC_BRIDGE_OP_RELAY=true
#     ↑ 是否把游戏内 /xn 私聊记录（问题+回答）私发给在线 OP（只记私聊；提问者自己除外）
# 游戏内聊天里贴的图片链接/图片代码 → 发成 QQ 群真图（零模组：直接贴公网图片链接即可）
MC_BRIDGE_GAME_IMAGE=true
# 转发前缀与关键词：
#   PREFIX_QQ —— QQ 消息转发进游戏时挂的前缀
#   PREFIX_MC —— 游戏消息转发到 QQ 时挂的前缀
#   KEYWORD   —— 游戏公聊里出现这个词才算在叫小钠（触发 AI 回复）
MC_BRIDGE_PREFIX_QQ=[QQ]
MC_BRIDGE_PREFIX_MC=[MC]
MC_BRIDGE_KEYWORD=小钠
# 游戏公聊 → QQ 的限速：同一玩家每窗口最多转发几条，超出的整条丢弃（不转发、也不触发 AI），
# 并在该窗口内只提示一次。防止有人在游戏里刷屏把 QQ 群刷爆、顶到 QQ 的发送频率限制。
# 正常聊天一般 10 秒不会超过 8 条；觉得还是太吵就把 MAX 调小，填 0 表示不限速。
MC_BRIDGE_CHAT_RATE_MAX=8
MC_BRIDGE_CHAT_RATE_WINDOW_SEC=10
# 重复内容屏蔽：同一玩家把同一句话反复刷，最多转发 3 条，第 4 条起屏蔽（0 = 关闭）。
# 计数不会因为退服/进服清零（退了再进来接着数），只在这句话超过 TTL 秒没再出现时重新算，
# 免得"哈哈""666"这种口头禅被永久拉黑。
MC_BRIDGE_DUP_MAX=3
MC_BRIDGE_DUP_TTL_SEC=300
# 可选：本机公网 IP。经端口复用时服务端只看到 127.0.0.1，
# 若在服务器 config.json 配了 bridge.allowFrom 白名单，需要在这里声明自己的 IP
MC_BRIDGE_FROM=
# 认出来的机器人（NapCat 群成员信息里的 is_robot）会标成「身份:机器人」；默认不接它的话，设 true 才回
BOT_REPLY=false
# 进群 / 退群提示：在群里发欢迎与送别消息（false 关闭）
QQ_GROUP_NOTICE=true
# 戳一戳：有人戳小钠就回一句（冷却见 config.json 的 cooldown.pokeMs；false 关闭）
POKE_REPLY=true
# 进群申请 / 好友申请：转发给主人，主人引用那条通知回复"同意"或"拒绝 [理由]"（false 关闭）
# 只转发、绝不自动同意；申请通知 3 天内可引用，过期会提醒主人并要对方重新申请
QQ_REQUEST_APPROVE=true

# ===== QQ ↔ 游戏ID 绑定 (#绑定 / #解绑 / #我的绑定) =====
# 桥接群的 QQ 消息只转发给「已绑定游戏ID」的账号；每人需先过图形验证码
# 每人可绑数量已移到 config.json 的 bind.maxPerQQ（网页「全局设置」可改）；
# 单个 QQ 的覆盖值由管理员及以上用 #绑定上限 命令设置
BIND_CAPTCHA_TTL=300

# ===== 语音识别（把 QQ 语音消息转成文字喂给 AI）=====
# 用**本地 FunASR（SenseVoice）**，默认指向 http://127.0.0.1:8899 。
# 先起本地服务：双击 startASR.bat（或运行
#   pip install funasr fastapi uvicorn python-multipart
#   funasr-server --host 127.0.0.1 --port 8899 --model sensevoice --device cpu
# ）；服务没起时语音只显示 [语音] 占位，其它功能不受影响。
# 下面几项都可留空用默认值；ASR_ENABLED=false 可整体关闭识别。
# 说明：QQ 语音多是 amr/silk，FunASR 吃不下，机器人会先让 NapCat 自己转成 wav 再识别（无需额外装工具）；
#       识别后还会按 config.json 的 asr 段做「同音纠正」（把小娜/小纳等错字改回小钠），改那里即可。
ASR_ENABLED=true
# 完整接口地址（FunASR 官方 OpenAI 兼容转写接口）
ASR_URL=http://127.0.0.1:8899/v1/audio/transcriptions
# 模型名（FunASR 1.4+ 服务端只认自己注册的名字，如 sensevoice / paraformer；
# 传 ModelScope 的 iic/SenseVoiceSmall 会被服务端 400 拒绝）
ASR_MODEL=sensevoice
# 若服务端要求鉴权，填了会带 Authorization: Bearer <token>
ASR_TOKEN=

# ===== GitHub 推送（push.bat 用；.env 已被 .gitignore 排除，不会上传）=====
# 个人访问令牌：GitHub → Settings → Developer settings → Tokens，权限只需 Contents: Read and write
GITHUB_TOKEN=
# 目标仓库 owner/repo
GITHUB_REPO=MaNing522/xiaona-bot