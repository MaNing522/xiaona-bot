# 复制为 .env 后填写自己的值（.env 已被 .gitignore 排除，不会上传）
# 说明：**没填的项对应的功能会自动停用**，机器人不会因此报错崩溃；
#       启动时会打印一份「功能状态」清单，告诉你哪些开着、哪些因为缺配置关着。
#       需要某个功能时，把对应配置补上、重启即可自动启用。

# ===== NapCat(OneBot11) 连接：真实QQ账号 =====
NAPCAT_WS=ws://127.0.0.1:3001
NAPCAT_TOKEN=
# ===== NapCat 面板（6099）登录 =====
# 登录账号固定是 napcat，密码就是这个 token；填了就会被固定住（NapCat 会把它写回 webui.json）
NAPCAT_WEBUI_TOKEN=
# 面板会话签名密钥：**必须固定**，否则 NapCat 每次启动都随机生成，重启一次面板就掉登录、要重输 token
# 随便一串固定的随机字符即可（建议 32 位以上）
NAPCAT_WEBUI_JWT_SECRET=

# 主人QQ（可执行 /授权 /取消授权）；管理员QQ（逗号分隔）
BOT_OWNER=
BOT_ADMINS=
# 主人主页/推广链接：会显示在 #状态 里（所有人可见，留空则不显示）
BOT_OWNER_HOME=

# 忽略的机器人QQ（逗号分隔），其消息不响应；默认已内置 Q群管家(2854196310)
BOT_IGNORE_QQ=

# ===== AI 配置 =====
# 服务商：deepseek(默认) / openai / custom（任何 OpenAI 兼容接口都可以选 custom 再填 URL+MODEL）
AI_PROVIDER=deepseek
# 下面两项留空则用所选服务商的默认值；显式填写优先
AI_API_URL=https://api.deepseek.com/chat/completions
AI_API_KEY=
AI_MODEL=deepseek-chat

# ===== 联网搜索（百度智能搜索 / 千帆 ai_search）=====
# 密钥形如 bce-v3/ALTAK-xxx/xxx；不填则联网搜索静默关闭
BAIDU_SEARCH_KEY=

# ===== 语音合成（玉峰 kktts.php，免密钥）=====
# 音色 ID 见 https://api-v2.yuafeng.cn/API/kktts.php?action=list
TTS_VOICE_ID=cc073894e597a60a8a784ef4b4e9b473

# ===== #余额 累计统计的基数（单位：元，可留空）=====
# DeepSeek 只给"当前余额"，没有历史账单接口；因此"累计充值/已使用"默认自首次查询起记账。
# 想让它们覆盖更早的历史，就从服务商账单页把数字抄到这里（留空则按 0 处理）。
AI_BALANCE_RECHARGE_BASE=
AI_BALANCE_GRANT_BASE=
AI_BALANCE_USED_BASE=

# ===== 存储（默认相对项目目录 data）=====
SAVE_DIR=

# ===== 日志（logger.js）=====
# 级别：trace / debug / info / warn / error / fatal（默认 info）
# 输出三处：终端（emoji 显示为 [表情]）、网页面板实时日志、logs/YYYY-MM-DD.log
LOG_LEVEL=info

# ===== 限速与冷却 =====
# 已全部移到 **config.json**（与 .env 分离）：限速、各类冷却、唤起会话都在那里调。
# 详见 config.json 内的注释，这里只留一句提醒，不再重复列键名。

# ===== 成本优化（aiService.js / idle.js）=====
# 输出 token 是成本大头，必须设上限（不设 = 放任模型写长）
AI_MAX_TOKENS=512             # 日常聊天
AI_MAX_TOKENS_SHORT=300       # 一句话的短问答
AI_MAX_TOKENS_LONG=1200       # 明确要长文（总结/展开/写一篇）
# 闲时维护（避开工作日 9:00-12:00、14:00-18:00）
IDLE_INTERVAL_MS=21600000     # 维护间隔（默认 6 小时）
IDLE_KICKOFF_MS=60000         # 启动后多久第一次尝试
VOICE_CACHE_KEEP=50           # 语音缓存保留文件数

# ===== 合并转发（#聊天记录）=====
# 转发间隔与同群冷却已移到 config.json 的 cooldown。

# ===== 网页控制面板 (webui.js) =====
# 账号 / 密码 / 监听地址（0.0.0.0 = 公开到局域网，127.0.0.1 = 仅本机）
# 面板能控制机器人（以机器人身份发消息、用 QQ 账密启动登录），务必自己设一个强密码；留空则面板不启动
WEBUI_HOST=127.0.0.1
# 默认 80（HTTP 标准端口，需管理员，启动.bat 已自动提权）。
# 若该端口被占用（如 Steam++/IIS/nginx），面板会自动顺延到 8080 → 8888 → 系统随机端口，
# 并在启动日志里打印实际监听端口；想固定端口就改这里。
WEBUI_PORT=80
WEBUI_USER=admin
WEBUI_PASSWORD=
# 面板放在反向代理（nginx 等）后面才开：开启后按 X-Forwarded-For 统计登录限速
WEBUI_TRUST_PROXY=false

# ===== 记忆配置 (memory.js) =====
MEMORY_MAX_RECENT=30
MEMORY_MAX_LONGTERM=50
MEMORY_MAX_AGE_DAYS=30
# 每次对话注入给 AI 的「最近对话」条数（建议 20~30；太多费 token）
MEMORY_CONTEXT_RECENT=20

# ===== 唤起会话（被 @/叫名字之后，接着几条没 @ 也继续判断是否在跟它说话）=====
# 额度在代码里固定：首先唤起的人 3 条、其他人插嘴 1 条；有效期 10 分钟（互动即续期）
# 想排查唤起行为时置 true，会在终端打印每次判断的额度消耗
ENGAGE_DEBUG=false

# ===== 人工接管 (takeover) =====
TAKEOVER_TIMEOUT=0

# ===== Minecraft 服务器桥（mcbridge.js ↔ 服务端 mod）=====
# 服务器侧 mod 在与 Minecraft 相同的端口上提供接口，这里填那个端口。
# 例：服务器 IP 为 1.2.3.4、config.json 里 http.sharePort=43733 → http://1.2.3.4:43733
MC_BRIDGE_URL=
# 必须与服务器 config/xiaona/config.json 里的 bridge.secret 完全一致，且不少于 32 个字符
MC_BRIDGE_SECRET=
# 桥接群号：游戏聊天发到这个群，这个群的消息也会转发进游戏（留空则游戏消息不发 QQ）
MC_BRIDGE_GROUP=
# 各部分开关
MC_BRIDGE_MC_TO_QQ=true
MC_BRIDGE_QQ_TO_MC=true
MC_BRIDGE_OP_RELAY=true
#     ↑ 是否把游戏内 /xn 私聊记录（问题+回答）私发给在线 OP（只记私聊；提问者自己除外）
# 游戏内聊天里贴的图片链接/图片代码 → 发成 QQ 群真图（零模组：直接贴公网图片链接即可）
MC_BRIDGE_GAME_IMAGE=true
# 转发前缀与关键词：
#   PREFIX_QQ —— QQ 消息转发进游戏时挂的前缀
#   PREFIX_MC —— 游戏消息转发到 QQ 时挂的前缀
#   KEYWORD   —— 游戏公聊里出现这个词才算在叫小钠（触发 AI 回复）
MC_BRIDGE_PREFIX_QQ=[QQ]
MC_BRIDGE_PREFIX_MC=[MC]
MC_BRIDGE_KEYWORD=小钠
# 游戏公聊 → QQ 的限速：同一玩家每窗口最多转发几条，超出的整条丢弃（不转发、也不触发 AI），
# 并在该窗口内只提示一次。防止有人在游戏里刷屏把 QQ 群刷爆、顶到 QQ 的发送频率限制。
# 正常聊天一般 10 秒不会超过 8 条；觉得还是太吵就把 MAX 调小，填 0 表示不限速。
MC_BRIDGE_CHAT_RATE_MAX=8
MC_BRIDGE_CHAT_RATE_WINDOW_SEC=10
# 重复内容屏蔽：同一玩家把同一句话反复刷，最多转发 3 条，第 4 条起屏蔽（0 = 关闭）。
# 计数不会因为退服/进服清零（退了再进来接着数），只在这句话超过 TTL 秒没再出现时重新算，
# 免得"哈哈""666"这种口头禅被永久拉黑。
MC_BRIDGE_DUP_MAX=3
MC_BRIDGE_DUP_TTL_SEC=300
# 可选：本机公网 IP。经端口复用时服务端只看到 127.0.0.1，
# 若在服务器 config.json 配了 bridge.allowFrom 白名单，需要在这里声明自己的 IP
MC_BRIDGE_FROM=
# 认出来的机器人（NapCat 群成员信息里的 is_robot）会标成「身份:机器人」；默认不接它的话，设 true 才回
BOT_REPLY=false
# 进群 / 退群提示：在群里发欢迎与送别消息（false 关闭）
QQ_GROUP_NOTICE=true
# 戳一戳：有人戳小钠就回一句（冷却见 config.json 的 cooldown.pokeMs；false 关闭）
POKE_REPLY=true
# 进群申请 / 好友申请：转发给主人，主人引用那条通知回复"同意"或"拒绝 [理由]"（false 关闭）
# 只转发、绝不自动同意；申请通知 30 分钟内可引用，过期要对方重新申请
QQ_REQUEST_APPROVE=true

# ===== QQ ↔ 游戏ID 绑定 (#绑定 / #解绑 / #我的绑定) =====
# 桥接群的 QQ 消息只转发给「已绑定游戏ID」的账号；每人需先过图形验证码
BIND_MAX_PER_QQ=3
BIND_CAPTCHA_TTL=300

# ===== GitHub 推送（push.bat 用；.env 已被 .gitignore 排除，不会上传）=====
# 个人访问令牌：GitHub → Settings → Developer settings → Tokens，权限只需 Contents: Read and write
GITHUB_TOKEN=
# 目标仓库 owner/repo
GITHUB_REPO=MaNing522/xiaona-bot